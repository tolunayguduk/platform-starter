# Kopyalayip .env olarak kaydedin: cp .env.example .env
# docker-compose.yml tarafindan otomatik okunur. .env dosyasi .gitignore'dadir.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=platform_app
MYSQL_PASSWORD=change-me-app

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

# Vault (dev mode token)
VAULT_DEV_ROOT_TOKEN_ID=change-me-token

# Grafana (observability profile)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-admin
